# ===== Majburiy =====
# Claude API kaliti (https://console.anthropic.com → API Keys). Faqat serverda ishlatiladi.
ANTHROPIC_API_KEY="sk-ant-..."
# Sessiya imzosi uchun kamida 32 belgili tasodifiy satr
SESSION_SECRET=""
# PostgreSQL ulanishi. Vercel'da Neon bazasini ulasangiz, avtomatik qo'shiladi.
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# ===== O'qituvchi hisobi =====
# Shu login va parol bilan birinchi marta kirganda o'qituvchi hisobi avtomatik yaratiladi.
TEACHER_LOGIN="ustoz"
TEACHER_PASSWORD=""
TEACHER_NAME="Ilyos Mahmudov"

# ===== Ixtiyoriy =====
# Baholash modeli. Arzonroq: claude-haiku-5-5, aniqroq: claude-opus-5-5
ANTHROPIC_MODEL="claude-sonnet-5-5"
# O'quvchilar o'zi ro'yxatdan o'ta oladimi (false — hisobni o'qituvchi yaratadi)
ALLOW_REGISTRATION="true"
# Bir o'quvchiga soatiga nechta tekshiruv
CHECKS_PER_HOUR="10"
