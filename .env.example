# ===== AI provayder =====
# Gemini (bepul darajasi bor): aistudio.google.com/apikey dan kalit oling.
# GEMINI_API_KEY berilsa, avtomatik Gemini ishlatiladi. Majburan tanlash: AI_PROVIDER="gemini" yoki "claude".
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.8-flash"
AI_PROVIDER=""

# Claude API kaliti (https://console.anthropic.com → API Keys). Faqat serverda ishlatiladi.
ANTHROPIC_API_KEY="sk-ant-..."
# (Ixtiyoriy) Sessiya imzosi. Berilmasa, DATABASE_URL'dan avtomatik hosil qilinadi.
SESSION_SECRET=""
# PostgreSQL ulanishi. Vercel'da Neon bazasini ulasangiz, avtomatik qo'shiladi.
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# ===== O'qituvchi hisobi =====
# Odatda kerak emas: saytda BIRINCHI ro'yxatdan o'tgan hisob o'qituvchi bo'ladi.
# Xohlasangiz, shu yerda belgilang — unda shu login va parol bilan birinchi kirishda o'qituvchi yaratiladi.
TEACHER_LOGIN="ustoz"
TEACHER_PASSWORD=""
TEACHER_NAME="Ilyos Mahmudov"

# ===== Ixtiyoriy =====
# Baholash modeli. Arzonroq: claude-haiku-5-5, aniqroq: claude-opus-5-5
ANTHROPIC_MODEL="claude-sonnet-5-5"
# O'quvchilar o'zi ro'yxatdan o'ta oladimi (false — hisobni o'qituvchi yaratadi)
ALLOW_REGISTRATION="true"
# Bir o'quvchiga soatiga nechta tekshiruv
CHECKS_PER_HOUR="10"
